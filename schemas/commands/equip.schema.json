{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "smartcraft/commands/equip.schema.json",
	"title": "equip: nimmt ein Item in die Hand oder legt es an",
	"args": {
		"type": "object",
		"required": [
			"item"
		],
		"additionalProperties": false,
		"properties": {
			"item": {
				"type": "string",
				"description": "Item-ID, z. B. stone_pickaxe"
			},
			"slot": {
				"enum": [
					"hand",
					"offhand",
					"head",
					"chest",
					"legs",
					"feet"
				],
				"default": "hand"
			}
		}
	},
	"result": {
		"type": "object",
		"properties": {
			"slot": {
				"type": "string"
			},
			"equipped": {
				"description": "Item in der Haupthand danach mit Anzahl und, bei Werkzeug, Haltbarkeit; null bei leerer Hand",
				"oneOf": [
					{
						"type": "null"
					},
					{
						"type": "object",
						"required": [
							"id",
							"count"
						],
						"properties": {
							"id": {
								"type": "string"
							},
							"count": {
								"type": "integer"
							},
							"durability": {
								"type": "object",
								"description": "Nur bei Werkzeug und Rüstung",
								"properties": {
									"left": {
										"type": "integer"
									},
									"max": {
										"type": "integer"
									}
								}
							}
						}
					}
				]
			},
			"held_item": {
				"description": "Item in der Haupthand danach mit Anzahl und, bei Werkzeug, Haltbarkeit; null bei leerer Hand",
				"oneOf": [
					{
						"type": "null"
					},
					{
						"type": "object",
						"required": [
							"id",
							"count"
						],
						"properties": {
							"id": {
								"type": "string"
							},
							"count": {
								"type": "integer"
							},
							"durability": {
								"type": "object",
								"description": "Nur bei Werkzeug und Rüstung",
								"properties": {
									"left": {
										"type": "integer"
									},
									"max": {
										"type": "integer"
									}
								}
							}
						}
					}
				]
			}
		}
	},
	"reasons": {
		"failed": [
			"no_bot",
			"invalid_args",
			"missing_item",
			"wrong_slot"
		],
		"cancelled": []
	}
}
