{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "aiplayer/commands/barter.schema.json",
	"title": "barter: tauscht Goldbarren mit Piglins in der Nähe (bis 16 Blöcke), ein Befehl für den ganzen Tausch. Wirft jedem freien erwachsenen Piglin einen Barren zu (nur er kann ihn aufheben), wartet, sammelt die Ware ein und macht weiter, bis count Barren getauscht sind. Brutes, Babys und Zombie-Piglins bekommen nichts. Etwa jeder 46. Barren bringt 2 bis 4 Enderperlen. Ergebnis: gold_given, gold_left, ender_pearls, gained",
	"args": {
		"type": "object",
		"required": [],
		"additionalProperties": false,
		"properties": {
			"count": {
				"type": "integer",
				"minimum": 1,
				"maximum": 128,
				"default": 16,
				"description": "So viele Goldbarren tauschen"
			}
		}
	},
	"result": {
		"type": "object",
		"properties": {
			"pos": {
				"type": "array",
				"items": {
					"type": "integer"
				},
				"minItems": 3,
				"maxItems": 3,
				"description": "Standort des Bots nach der Aktion"
			},
			"ticks": {
				"type": "integer",
				"description": "Dauer der Aktion in Ticks (20 pro Sekunde)"
			},
			"hint": {
				"type": "string",
				"description": "Genauer, woran es lag"
			},
			"trigger": {
				"type": "object",
				"description": "Bei cancelled wegen danger/damage: das auslösende Event"
			},
			"gained": {
				"type": "array",
				"items": {
					"type": "object",
					"required": [
						"id",
						"count"
					],
					"properties": {
						"id": {
							"type": "string"
						},
						"count": {
							"type": "integer"
						},
						"durability": {
							"type": "object",
							"description": "Nur bei Werkzeug und Rüstung",
							"properties": {
								"left": {
									"type": "integer"
								},
								"max": {
									"type": "integer"
								}
							}
						}
					}
				},
				"description": "Was dabei neu ins Inventar kam"
			},
			"gold_given": {
				"type": "integer",
				"description": "Geworfene Barren"
			},
			"gold_left": {
				"type": "integer"
			},
			"ender_pearls": {
				"type": "integer",
				"description": "Enderperlen im Inventar danach"
			},
			"babies_nearby": {
				"type": "integer",
				"description": "Bei no_piglin: Baby-Piglins in der Nähe (tauschen nicht)"
			}
		}
	},
	"reasons": {
		"failed": [
			"no_bot",
			"bot_died",
			"invalid_args",
			"timeout",
			"missing_item",
			"no_piglin",
			"piglins_unreachable",
			"piglins_angry",
			"brute_nearby"
		],
		"cancelled": [
			"stopped",
			"superseded",
			"danger",
			"damage"
		]
	}
}
