{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "smartcraft/commands/settings.schema.json",
	"title": "settings: nur für den Begleitprozess, nicht für das Modell. Setzt die übergebenen Einstellungen (Startwerte aus seiner Umgebung) und liefert alle aktuellen zurück; geht auch ohne Bot. Der Mod ist die Quelle der Wahrheit, spätere Änderungen kommen als control_requested mit action settings",
	"args": {
		"type": "object",
		"additionalProperties": false,
		"properties": {
			"tts": {
				"type": "boolean"
			},
			"humor": {
				"enum": [
					"light",
					"medium",
					"hard",
					"crazy"
				]
			},
			"talkmode": {
				"enum": [
					"light",
					"medium",
					"hard"
				]
			},
			"provider": {
				"enum": [
					"anthropic",
					"openai",
					"gemini"
				]
			},
			"model": {
				"type": "string",
				"description": "Leer heißt Standardmodell des Anbieters"
			}
		}
	},
	"result": {
		"type": "object",
		"properties": {
			"tts": {
				"type": "boolean"
			},
			"humor": {
				"type": "string"
			},
			"talkmode": {
				"type": "string"
			},
			"dimension_follow": {
				"type": "boolean"
			},
			"streamer": {
				"type": "boolean"
			},
			"provider": {
				"type": "string"
			},
			"model": {
				"type": "string",
				"description": "Leer heißt Standardmodell"
			},
			"api_keys": {
				"type": "object",
				"description": "Nur wenn vor dem Verbinden /smartcraft apikey gegeben wurde (einmalig): Anbieter -> Schlüssel; der Begleitprozess speichert sie, in Logs steht ***"
			}
		}
	},
	"reasons": {
		"failed": [
			"invalid_args"
		],
		"cancelled": []
	}
}
