{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "smartcraft/commands/inventory.schema.json",
	"title": "inventory: das vollständige Inventar. Nur auf Abruf, weil es viele Tokens kostet",
	"args": {
		"type": "object",
		"required": [],
		"additionalProperties": false,
		"properties": {}
	},
	"result": {
		"type": "object",
		"properties": {
			"items": {
				"type": "array",
				"items": {
					"type": "object",
					"required": [
						"id",
						"count"
					],
					"properties": {
						"id": {
							"type": "string"
						},
						"count": {
							"type": "integer"
						},
						"durability": {
							"type": "object",
							"description": "Nur bei Werkzeug und Rüstung",
							"properties": {
								"left": {
									"type": "integer"
								},
								"max": {
									"type": "integer"
								}
							}
						},
						"slot": {
							"type": "integer",
							"description": "0 bis 8 Schnellleiste, 9 bis 35 Rest"
						}
					}
				}
			},
			"worn": {
				"type": "object",
				"description": "Rüstung und Zweithand: head, chest, legs, feet, offhand"
			},
			"held_slot": {
				"type": "integer"
			},
			"free_slots": {
				"type": "integer"
			},
			"end_missing": {
				"type": "array",
				"items": { "type": "string" },
				"description": "Oberwelt und Nether: was für das End und den Drachen noch fehlt (12 Betten, 18 Enderaugen, Bogen, 64 Pfeile, 128 Bausteine, 16 Essen; Vorstufen zählen mit)"
			},
			"end_ready": {
				"type": "boolean",
				"description": "Alles für das End beisammen"
			},
			"nether_missing": {
				"type": "array",
				"items": {
					"type": "string"
				},
				"description": "Nur in der Oberwelt: was für den Nether noch fehlt (wie build_portal not_prepared, plus 10 Obsidian)"
			},
			"nether_ready": {
				"type": "boolean",
				"description": "Nur in der Oberwelt: alles für den Nether da"
			}
		}
	},
	"reasons": {
		"failed": [
			"no_bot"
		],
		"cancelled": []
	}
}